# Copy to .env in the TRACEGUARD server's project folder and select existing roots.
# Only this server-local .env is loaded; scanned projects' .env files are ignored.
# Explicit process/Codex environment values take precedence, including invalid ones.
# Required: JSON array of 1-32 absolute directories. No ~ or wildcard expansion.
# Filesystem/drive roots are rejected; choose specific readable directories.
# Windows: forward slashes avoid JSON backslash-escaping mistakes.
TRACEGUARD_ALLOWED_ROOTS='["C:/Users/rajpu/OneDrive/Desktop/trackgaurd"]'
# macOS: replace the Windows line above with your actual existing directory:
# TRACEGUARD_ALLOWED_ROOTS='["/Users/prachi/projects"]'
# Windows backslashes must be doubled inside JSON strings; forward slashes are simpler.
# Trusted server-owned cache and artifact directory (never a scanned project).
# TRACEGUARD_DATA_DIR=/Users/alice/Library/Caches/traceguard-mcp
TRACEGUARD_MAX_OUTPUT_BYTES=16000
TRACEGUARD_MAX_FINDINGS=10
TRACEGUARD_OSV_TTL_SECONDS=3600
TRACEGUARD_OSV_TIMEOUT_MS=15000
